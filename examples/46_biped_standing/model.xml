<mujoco model="floating biped standing">
  <option timestep="0.001" integrator="implicitfast" solver="Newton"/>
  <default>
    <joint damping="1" armature=".03" limited="true" range="-60 60"/>
    <geom type="capsule" size=".045" mass="1" friction="1 .01 .001"/>
    <position kp="120" kv="12" ctrlrange="-1 1" ctrllimited="true" forcerange="-80 80" forcelimited="true"/>
  </default>
  <worldbody>
    <geom name="floor" type="plane" size="3 3 .1" mass="0" friction="1 .01 .001"/>
    <body name="pelvis" pos="0 0 .78">
      <freejoint/><geom type="box" size=".16 .16 .09" mass="8" rgba=".3 .3 .7 1"/>
      <body name="left_thigh" pos="0 .12 0">
        <joint name="left_hip_roll" axis="1 0 0"/><joint name="left_hip_pitch" axis="0 1 0"/>
        <geom fromto="0 0 0 0 0 -.35" mass="2"/>
        <body name="left_shin" pos="0 0 -.35"><joint name="left_knee" axis="0 1 0" range="-5 100"/>
          <geom fromto="0 0 0 0 0 -.35" mass="1.5"/>
          <body name="left_foot" pos="0 0 -.35">
            <joint name="left_ankle_pitch" axis="0 1 0"/><joint name="left_ankle_roll" axis="1 0 0"/>
            <geom name="left_foot_geom" type="box" pos=".06 0 -.04" size=".16 .10 .04" mass="1"/>
          </body>
        </body>
      </body>
      <body name="right_thigh" pos="0 -.12 0">
        <joint name="right_hip_roll" axis="1 0 0"/><joint name="right_hip_pitch" axis="0 1 0"/>
        <geom fromto="0 0 0 0 0 -.35" mass="2"/>
        <body name="right_shin" pos="0 0 -.35"><joint name="right_knee" axis="0 1 0" range="-5 100"/>
          <geom fromto="0 0 0 0 0 -.35" mass="1.5"/>
          <body name="right_foot" pos="0 0 -.35">
            <joint name="right_ankle_pitch" axis="0 1 0"/><joint name="right_ankle_roll" axis="1 0 0"/>
            <geom name="right_foot_geom" type="box" pos=".06 0 -.04" size=".16 .10 .04" mass="1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position joint="left_hip_roll"/><position joint="left_hip_pitch"/><position joint="left_knee"/>
    <position joint="left_ankle_pitch"/><position joint="left_ankle_roll"/>
    <position joint="right_hip_roll"/><position joint="right_hip_pitch"/><position joint="right_knee"/>
    <position joint="right_ankle_pitch"/><position joint="right_ankle_roll"/>
  </actuator>
</mujoco>
